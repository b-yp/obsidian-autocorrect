{
	"name": "autocorrect-formatter",
	"version": "1.1.1",
	"description": "A plugin running on Obsidian that utilizes autocorrect to format Markdown content.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.19.43",
		"@types/uuid": "^10.0.0",
		"@typescript-eslint/eslint-plugin": "5.29.0",
		"@typescript-eslint/parser": "5.29.0",
		"builtin-modules": "3.3.0",
		"esbuild": "^0.21.5",
		"obsidian": "^1.13.1",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"@huacnlee/autocorrect": "^2.16.2",
		"uuid": "^10.0.0"
	}
}
